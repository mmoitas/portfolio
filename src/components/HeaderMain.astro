---
import frameSides from '../assets/base/frame-sides.png';
---

<header class="header-main">
	<div class="content">
		<div class="text-slot">
			<p class="text-pretitle"><slot name="pretitle" /></p>
			<h1 class="text-display-1"><slot name="name" /></h1>
			<div class="text-body-large">
				<slot name="description" />
			</div>
		</div>
		<div class="media-slot">
			<slot name="media" />
		</div>
	</div>
</header>

<style>
	.header-main {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 1920px;
		overflow: hidden;
		padding: var(--space-14);
		margin: 0 auto;
		background-image: 
			url(../assets/base/frame-left.png), 
			url(../assets/base/frame-right.png), 
			url(../assets/base/frame-top.png), 
			url(../assets/base/frame-bottom.png),
			url(../assets/base/tl-corner.png),
			url(../assets/base/tr-corner.png),
			url(../assets/base/bl-corner.png),
			url(../assets/base/br-corner.png);
			background-position: 
			left top, 
			right top, 
			center top, 
			center bottom, 
			left top, 
			right top,
			left bottom, 
			right bottom;
		background-repeat: 
			repeat-y, 
			repeat-y, 
			repeat-x, 
			repeat-x, 
			no-repeat,
			no-repeat,
			no-repeat,
			no-repeat;
		background-color: var(--brand-1);
	}

	.content {
		display: flex;
		align-items: center;
		width: 100%;
		padding-block: var(--space-14);
	}

	.text-slot {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		flex: 1 0 0;
		min-width: 0;
		max-width: 720px;
		word-break: break-word;
	}

	.text-slot .text-display-1,
	.text-slot .text-pretitle,
	.text-slot .text-body-large {
		width: 100%;
	}

	.media-slot {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 0 0;
		min-width: 0;
	}

	.media-slot :global(img),
	.media-slot :global(svg) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 768px) {
		.content {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.text-slot {
			max-width: none;
		}
	}
</style>
