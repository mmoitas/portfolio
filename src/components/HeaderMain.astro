---
---

<header class="header-main">
	<div class="content">
		<div class="text-slot">
			<p class="text-pretitle"><slot name="pretitle" /></p>
			<h1 class="text-display-1"><slot name="name" /></h1>
			<div class="text-body-large">
				<slot name="description" />
			</div>
		</div>
		<div class="media-slot">
			<slot name="media" />
		</div>
	</div>
</header>

<style>
	.header-main {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
		overflow: hidden;
		padding: var(--padding-large);
		background-color: var(--brand-1);
	}

	.content {
		display: flex;
		align-items: center;
		width: 100%;
		padding-block: var(--padding-xlarge);
	}

	.text-slot {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		flex: 1 0 0;
		min-width: 0;
		max-width: 720px;
		word-break: break-word;
	}

	.text-slot .text-display-1,
	.text-slot .text-pretitle,
	.text-slot .text-body-large {
		width: 100%;
	}

	.media-slot {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 0 0;
		min-width: 0;
	}

	.media-slot :global(img),
	.media-slot :global(svg) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 768px) {
		.content {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--padding-medium);
		}

		.text-slot {
			max-width: none;
		}
	}
</style>
