---
interface Props {
	dividers?: boolean;
}

const { dividers = false } = Astro.props;
---

<div class="bento-card-2col" data-dividers={dividers ? '' : undefined}>
	<div class="text-slot"><slot name="text" /></div>
	<div class="media-slot"><slot name="media" /></div>
</div>

<style>
	.bento-card-2col {
		display: flex;
		align-items: flex-start;
		gap: var(--padding-medium);
		width: 100%;
		box-sizing: border-box;
		padding: var(--padding-xlarge) var(--padding-medium);
	}

	.bento-card-2col[data-dividers] {
		border-right: var(--stroke-size-default) solid var(--stroke-color-primary);
	}

	.text-slot,
	.media-slot {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		min-width: 0;
	}

	.text-slot {
		flex: 40 0 0;
	}

	.media-slot {
		flex: 60 0 0;
	}

	.text-slot :global(.text-body-default) {
		max-width: 640px;
	}

	/* Below 768px the two columns stack: text above media, both full-width.
	   The right divider (dividers prop) stays as-is at every width. */
	@media (max-width: 768px) {
		.bento-card-2col {
			flex-direction: column;
		}
	}
</style>
