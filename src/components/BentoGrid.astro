---
interface Props {
	dividers?: boolean;
}

const { dividers = false } = Astro.props;
---

<div class="bento-grid" data-dividers={dividers ? '' : undefined}>
	<div class="bento-grid-row">
		<slot />
	</div>
</div>

<style>
	.bento-grid {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
	}

	.bento-grid[data-dividers] {
		border-bottom: var(--stroke-size-default) solid var(--stroke-color-primary);
	}

	.bento-grid-row {
		display: flex;
		align-items: stretch;
		width: 100%;
	}

	/* 1 or 2 Bento Cards can be slotted in. Cards split the row evenly
	   (a single card fills it, two get 50% each) unless a card sets its
	   `width` prop, which fixes its share; the other card takes the rest. */
	.bento-grid-row > :global(*) {
		flex: 1 1 0;
		min-width: 0;
	}

	.bento-grid-row > :global([data-width]) {
		flex: 0 0 var(--bento-card-width);
		max-width: var(--bento-card-width);
	}

	@media (max-width: 768px) {
		.bento-grid-row {
			flex-direction: column;
		}

		.bento-grid-row > :global(*),
		.bento-grid-row > :global([data-width]) {
			flex: 1 0 auto;
			max-width: 100%;
		}
	}
</style>
