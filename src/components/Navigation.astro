---
export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<nav class:list={['navigation', className]} aria-label="Primary">
	<div class="left-actions">
		<button
			type="button"
			class="nav-button"
			aria-haspopup="dialog"
			aria-controls="nav-menu"
			aria-expanded="false"
			aria-label="Open menu"
		>
			<img src="/images/icons/head-medium.svg" alt="" class="site-icon" width="40" height="40" />
			<span class="label-spin" aria-hidden="true">
				<img src="/images/nav-label.svg" alt="" class="menu-label" />
			</span>
		</button>
	</div>
	<ul class="right-actions">
		<li>
			<a href="mailto:mmoitas@gmail.com" class="contact-link" aria-label="Email mmoitas@gmail.com">
				<img src="/images/icons/mail-small-dark.svg" alt="" width="32" height="32" />
			</a>
		</li>
		<li>
			<a
				href="https://linkedin.com/in/moitas/"
				class="contact-link"
				aria-label="LinkedIn profile (opens in a new tab)"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img src="/images/icons/linkedin-small-dark.svg" alt="" width="32" height="32" />
			</a>
		</li>
	</ul>
</nav>

<script>
	const navigation = document.querySelector<HTMLElement>('.navigation');

	if (navigation) {
		const update = () => navigation.classList.toggle('is-scrolled', window.scrollY > 0);
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>

<style>
	/* Stays pinned to the top of the window while the page scrolls. */
	.navigation {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		/* The bar (and its bottom stroke) spans the full window, but the side
		   padding grows past 1920px so the content lines up with HeaderMain's
		   1920px max-width box and its --space-14 padding. */
		padding-block: var(--space-4);
		padding-inline: max(var(--space-14), calc((100% - 1920px) / 2 + var(--space-14)));
		background-color: var(--surface-color-0);
		/* Always 1px tall so the bar doesn't change height. It's transparent
		   at the top of the page; the script adds .is-scrolled to show it. */
		border-bottom: var(--stroke-size-default) solid transparent;
		transition: border-color 200ms ease;
	}

	.navigation.is-scrolled {
		border-bottom-color: var(--neutral-100);
	}

	.left-actions {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}

	/* Same links as the footer's contact list. */
	.right-actions {
		display: flex;
		align-items: center;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Spacing comes from the flex gap above, not the global li margin. */
	.right-actions li {
		margin: 0;
	}

	.contact-link {
		display: block;
		border-radius: var(--space-2);
		transition: opacity 150ms ease;
	}

	.contact-link:hover {
		opacity: 0.6;
	}

	.contact-link:focus-visible {
		outline: 2px solid var(--stroke-color-primary);
		outline-offset: 4px;
	}

	.contact-link img {
		display: block;
	}

	.nav-button {
		position: relative;
		display: flex;
		align-items: center;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		gap: var(--space-2);
		background-color: var(--neutral-2);
	}

	/* Figma "labelSpin": a frame the size of the head, so it rotates
	   around the head's center, carrying the curved label with it. */
	.label-spin {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
	}

	.menu-label {
		position: absolute;
		left: 30px;
		top: -9px;
		width: 23.291px;
		height: 58.432px;
	}

	.nav-button:hover .label-spin,
	.nav-button:focus-visible .label-spin {
		opacity: 1;
		animation: label-spin 2s linear infinite;
	}

	@keyframes label-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.navigation {
			transition: none;
		}

		.nav-button:hover .label-spin,
		.nav-button:focus-visible .label-spin {
			animation: none;
		}
	}

	.site-name {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
	}

	.site-icon {
		display: block;
	}
</style>
