---
export interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={['footer', className]}>
	<h2 class="footer-title">
		<slot>Want to know more?<br />Let’s talk!</slot>
	</h2>
	<ul class="contact">
		<li>
			<a href="mailto:mmoitas@gmail.com" class="contact-link">
				<img src="/images/icons/mail-small.svg" alt="" width="32" height="32" />
				<span>mmoitas@gmail.com</span>
			</a>
		</li>
		<li>
			<a
				href="https://linkedin.com/in/moitas/"
				class="contact-link"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img src="/images/icons/linkedin-small.svg" alt="" width="32" height="32" />
				<span>linkedin.com/in/moitas/</span>
			</a>
		</li>
	</ul>
</footer>

<style>
	.footer {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-10);
		width: 100%;
		padding: var(--space-12) var(--space-16);
		background-color: var(--surface-color-9);
		color: var(--text-color-tertiary);
	}

	.footer-title {
		margin: 0;
		font-family: var(--font-family-body);
		font-size: 48px;
		font-weight: 650;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variation-settings: 'wdth' 125;
	}

	.contact {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact-link {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-family-body);
		font-size: var(--body-default-font-size);
		line-height: var(--body-default-line-height);
		font-weight: 700;
		font-variation-settings: 'wdth' 100;
		color: inherit;
		text-decoration: none;
	}

	.contact-link:hover span,
	.contact-link:focus-visible span {
		text-decoration: underline;
	}

	.contact-link img {
		display: block;
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.footer {
			padding: var(--space-12) var(--space-6);
		}

		.footer-title {
			font-size: 32px;
		}
	}
</style>
