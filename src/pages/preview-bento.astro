---
import Layout from '../layouts/Layout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard2Col from '../components/BentoCard2Col.astro';
import BentoCard2Row from '../components/BentoCard2Row.astro';
---

<Layout>
	<BentoGrid dividers>
		<BentoCard2Col dividers>
			<Fragment slot="text">
				<h2 class="text-display-3">One row, two columns</h2>
				<p class="text-body-default">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut nec mi et nulla maximus
					posuere.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/1328x623/eeeeee/151515?text=media"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
			</Fragment>
		</BentoCard2Col>
		<BentoCard2Col>
			<Fragment slot="text">
				<h2 class="text-display-3">One row, two columns</h2>
				<p class="text-body-default">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut nec mi et nulla maximus
					posuere.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/1328x623/eeeeee/151515?text=media"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
			</Fragment>
		</BentoCard2Col>
	</BentoGrid>

	<BentoGrid>
		<BentoCard2Row>
			<Fragment slot="text">
				<h2 class="text-display-3">Two rows, one column</h2>
				<p class="text-body-default">
					I'm baby jean shorts lockwood affogato moka pot claire saffitz crochet capitalist realism, offal plaid austin. Jacobin are.na ottessa moshfegh flexitarian YIMBY, capitalist realism echo park jianbing decolonize cahiers everyday carry church-key bicycle rights four dollar toast bluesky. Bone broth fingerstache air plant, kettlebell ashwagandha nervous system ugh disrupt red light therapy herman miller. Listening bar duck fat yr gorpcore, ceramics jean shorts mubi craft beer lo-fi vegan DIY coastal grandma taiyaki dog dad. Tbh ethical 3 wolf moon mushroom coffee franzen.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/1328x623/eeeeee/151515?text=media"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
