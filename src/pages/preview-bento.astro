---
import Layout from '../layouts/Layout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard2Col from '../components/BentoCard2Col.astro';
import BentoCard2Row from '../components/BentoCard2Row.astro';
import HeaderProject from '../components/HeaderProject.astro';
---

<Layout>
	<HeaderProject background="2">
		<Fragment slot="title">Project title (2)</Fragment>
		<Fragment slot="body">
			Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut nec mi et nulla
			maximus posuere. Sed vitae ipsum placerat, finibus tortor et, faucibus sem.
		</Fragment>
		<Fragment slot="media">
			<img
				src="https://placehold.co/500x380"
				alt="Placeholder media"
			/>
		</Fragment>
	</HeaderProject>
	<BentoGrid dividers>
		<BentoCard2Col dividers zoomable>
			<Fragment slot="text">
				<h2 class="text-display-3">One row, two columns</h2>
				<p class="text-body-default">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut nec mi et nulla maximus
					posuere.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/400x500"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
			</Fragment>
		</BentoCard2Col>
		<BentoCard2Row zoomable>
			<Fragment slot="text">
				<h2 class="text-display-3">One row, two columns</h2>
				<p class="text-body-default">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut nec mi et nulla maximus
					posuere.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/500x300"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
			</Fragment>
		</BentoCard2Row>
	</BentoGrid>

	<BentoGrid dividers>
		<BentoCard2Col>
			<Fragment slot="text">
				<h2 class="text-display-3">Two rows, one column</h2>
				<p class="text-body-default">
					I'm baby jean shorts lockwood affogato moka pot claire saffitz crochet capitalist realism, offal plaid austin. Jacobin are.na ottessa moshfegh flexitarian YIMBY, capitalist realism echo park jianbing decolonize cahiers everyday carry church-key bicycle rights four dollar toast bluesky. Bone broth fingerstache air plant, kettlebell ashwagandha nervous system ugh disrupt red light therapy herman miller. Listening bar duck fat yr gorpcore, ceramics jean shorts mubi craft beer lo-fi vegan DIY coastal grandma taiyaki dog dad. Tbh ethical 3 wolf moon mushroom coffee franzen.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/500x360"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
			</Fragment>
		</BentoCard2Col>
	</BentoGrid>

	<BentoGrid>
		<BentoCard2Row>
			<Fragment slot="text">
				<h2 class="text-display-3">Two rows, one column</h2>
				<p class="text-body-default">
					I'm baby jean shorts lockwood affogato moka pot claire saffitz crochet capitalist realism, offal plaid austin. Jacobin are.na ottessa moshfegh flexitarian YIMBY, capitalist realism echo park jianbing decolonize cahiers everyday carry church-key bicycle rights four dollar toast bluesky. Bone broth fingerstache air plant, kettlebell ashwagandha nervous system ugh disrupt red light therapy herman miller. Listening bar duck fat yr gorpcore, ceramics jean shorts mubi craft beer lo-fi vegan DIY coastal grandma taiyaki dog dad. Tbh ethical 3 wolf moon mushroom coffee franzen.
				</p>
			</Fragment>
			<Fragment slot="media">
				<img
					src="https://placehold.co/500x200"
					alt="Placeholder media"
					style="width: 100%; height: auto; display: block;"
				/>
				<p class="text-body-small">Caption describing the media above.</p>
			</Fragment>
		</BentoCard2Row>
	</BentoGrid>
</Layout>
